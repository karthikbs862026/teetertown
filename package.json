{
  "name": "teetertown",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:e2e": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:lab": "tsc -b && vite build --mode lab",
    "preview": "vite preview --host 0.0.0.0",
    "preview:e2e": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:simulation": "vitest run tests/simulation",
    "test:replay": "vitest run tests/simulation/replay.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:ci": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chromium --project=mobile-webkit",
    "test:visual": "playwright test tests/visual",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "check:boundaries": "node --import tsx scripts/check-boundaries.ts",
    "check:circular": "node --import tsx scripts/check-circular.ts",
    "check:budgets": "node --import tsx scripts/check-budgets.ts",
    "check:lab-leak": "node --import tsx scripts/check-production-bundle.ts",
    "profile:headless": "node --import tsx scripts/profile-headless.ts",
    "check:fast": "npm run typecheck && npm run lint && npm run format:check && npm run validate:content && npm run check:boundaries && npm run check:circular && npm run test",
    "check:production": "npm run build && npm run check:budgets && npm run check:lab-leak"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.19.3",
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "@types/three": "0.185.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
